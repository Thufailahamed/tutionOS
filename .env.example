# Copy to apps/web/.dev.vars for local development secrets.
# Never commit real values.

# Auth
SESSION_SECRET=change-me-local-secret

# Optional providers (leave empty to use log providers in dev)
SMS_PROVIDER=log
SMS_API_KEY=
SMS_SENDER_ID=
EMAIL_PROVIDER=log
EMAIL_API_KEY=
EMAIL_FROM=

# WhatsApp (future provider integration)
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=

# Cloudflare (for deploy)
CLOUDFLARE_ACCOUNT_ID=
